{
  "name": "pp-thaileague-fantasy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3006",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types": "tsc -p tsconfig.json --noEmit --skipLibCheck",
    "test:email": "node --experimental-strip-types --test src/lib/email/*.test.ts",
    "test:auth": "node --experimental-strip-types --test src/lib/auth/*.test.ts",
    "test:rules": "node --experimental-strip-types --test src/lib/fantasy/*.test.ts",
    "db:check": "node --require ./scripts/windows-node-user-info-shim.cjs --import tsx ./scripts/check-database.ts",
    "db:generate": "node --require ./scripts/windows-node-user-info-shim.cjs ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --require ./scripts/windows-node-user-info-shim.cjs ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:rank:leagues": "node --conditions react-server --require ./scripts/windows-node-user-info-shim.cjs --import tsx ./scripts/backfill-league-standings.ts",
    "db:report:participants": "node --conditions react-server --require ./scripts/windows-node-user-info-shim.cjs --import tsx ./scripts/report-fantasy-participants.ts",
    "db:scenario": "node --conditions react-server --require ./scripts/windows-node-user-info-shim.cjs --import tsx ./scripts/run-fantasy-scenario.ts",
    "db:studio": "node --require ./scripts/windows-node-user-info-shim.cjs ./node_modules/drizzle-kit/bin.cjs studio",
    "db:verify:competition": "node --require ./scripts/windows-node-user-info-shim.cjs --import tsx ./scripts/verify-competition-data.ts",
    "db:verify:fantasy": "node --require ./scripts/windows-node-user-info-shim.cjs --import tsx ./scripts/verify-fantasy-game.ts",
    "db:verify:player-stats": "node --require ./scripts/windows-node-user-info-shim.cjs --import tsx ./scripts/verify-current-season-player-stats.ts",
    "db:verify:transaction": "node --require ./scripts/windows-node-user-info-shim.cjs --import tsx ./scripts/verify-fantasy-transaction.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/nextjs": "^10.73.0",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@next/env": "^16.3.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "volta": {
    "node": "24.18.1",
    "npm": "12.0.2"
  }
}
