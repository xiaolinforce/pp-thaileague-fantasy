{
  "name": "pp-thaileague-fantasy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3006",
    "build": "next build",
    "start": "next start",
    "email:dev": "email dev --dir src/emails --port 3007",
    "email:preview": "node --require ./scripts/windows-node-user-info-shim.cjs --import tsx ./scripts/render-email-preview.tsx",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types": "tsc -p tsconfig.json --noEmit --skipLibCheck",
    "test:email": "node --test src/lib/email/*.test.ts",
    "test:email-template": "node --require ./scripts/windows-node-user-info-shim.cjs --import tsx --test src/emails/*.test.tsx",
    "test:email:integration": "node --conditions react-server --require ./scripts/windows-node-user-info-shim.cjs --import tsx --test scripts/tests/email-delivery.test.ts",
    "test:auth": "node --test src/lib/auth/*.test.ts",
    "test:maintenance": "node --conditions react-server --require ./scripts/windows-node-user-info-shim.cjs --import tsx --test scripts/tests/auth-maintenance.test.ts",
    "test:observability": "node --test src/lib/observability/*.test.ts",
    "test:requests": "node --require ./scripts/windows-node-user-info-shim.cjs --import tsx --test scripts/tests/root-request.test.ts",
    "test:i18n": "node --require ./scripts/windows-node-user-info-shim.cjs --import tsx --test scripts/tests/localization.test.tsx",
    "test:admin": "node --require ./scripts/windows-node-user-info-shim.cjs --import tsx --test scripts/tests/admin-action-button.test.tsx",
    "test:rules": "node --test src/lib/fantasy/*.test.ts",
    "db:check": "node --require ./scripts/windows-node-user-info-shim.cjs --import tsx ./scripts/check-database.ts",
    "db:generate": "node --require ./scripts/windows-node-user-info-shim.cjs ./node_modules/drizzle-kit/bin.cjs generate",
    "db:review": "node scripts/release/review-migration.ts",
    "db:migrate": "node --require ./scripts/windows-node-user-info-shim.cjs ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:backfill:optimal-teams": "node --conditions react-server --require ./scripts/windows-node-user-info-shim.cjs --import tsx ./scripts/backfill-optimal-teams.ts",
    "db:rank:leagues": "node --conditions react-server --require ./scripts/windows-node-user-info-shim.cjs --import tsx ./scripts/backfill-league-standings.ts",
    "db:report:participants": "node --conditions react-server --require ./scripts/windows-node-user-info-shim.cjs --import tsx ./scripts/report-fantasy-participants.ts",
    "db:audit:player-clubs": "node --conditions react-server --require ./scripts/windows-node-user-info-shim.cjs --import tsx ./scripts/audit-fantasy-player-clubs.ts",
    "db:scenario": "node --conditions react-server --require ./scripts/windows-node-user-info-shim.cjs --import tsx ./scripts/run-fantasy-scenario.ts",
    "db:studio": "node --require ./scripts/windows-node-user-info-shim.cjs ./node_modules/drizzle-kit/bin.cjs studio",
    "db:verify:competition": "node --require ./scripts/windows-node-user-info-shim.cjs --import tsx ./scripts/verify-competition-data.ts",
    "db:verify:tiers": "node --conditions react-server --require ./scripts/windows-node-user-info-shim.cjs --import tsx ./scripts/verify-two-tier-rules.ts",
    "db:verify:tier-relief": "node --conditions react-server --require ./scripts/windows-node-user-info-shim.cjs --import tsx ./scripts/verify-tier-relief.ts",
    "db:verify:fantasy": "node --require ./scripts/windows-node-user-info-shim.cjs --import tsx ./scripts/verify-fantasy-game.ts",
    "db:verify:player-stats": "node --require ./scripts/windows-node-user-info-shim.cjs --import tsx ./scripts/verify-current-season-player-stats.ts",
    "db:verify:transaction": "node --require ./scripts/windows-node-user-info-shim.cjs --import tsx ./scripts/verify-fantasy-transaction.ts",
    "test:readiness": "node --conditions react-server --require ./scripts/windows-node-user-info-shim.cjs --import tsx --test scripts/tests/readiness.test.ts scripts/tests/ownership-heartbeat.test.ts",
    "test:release": "node --test scripts/tests/release.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@neondatabase/serverless": "^1.2.1",
    "@sentry/nextjs": "^11.14.0",
    "better-auth": "^1.7.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.16",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "yalps": "^0.6.4"
  },
  "devDependencies": {
    "@next/env": "16.4.6",
    "@react-email/ui": "6.11.16",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "module-punycode": "npm:punycode@^2.3.1",
    "prettier": "^3.9.6",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "volta": {
    "node": "26.13.1",
    "npm": "12.2.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "engines": {
    "node": "26.x"
  }
}
