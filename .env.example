# Use the pooled connection string for the target Neon branch.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require

# QA scenario runner guard. Copy the exact Neon branch ID for the disposable
# branch targeted by DATABASE_URL; scenario writes refuse any mismatch.
FANTASY_SCENARIO_BRANCH_ID=
# Optional when the database contains more than one Fantasy season or when you
# want to choose the signed-in tester's team explicitly.
FANTASY_SCENARIO_SEASON_SLUG=
FANTASY_SCENARIO_PRIMARY_TEAM=

# Better Auth. Generate both secrets with a cryptographically secure generator.
BETTER_AUTH_URL=http://localhost:3006
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_EMAIL_HASH_SECRET=replace-with-a-separate-random-secret

# External sign-in methods are opt-in per environment. Keep both false until
# the matching provider settings below are complete.
AUTH_EMAIL_ENABLED=false
AUTH_GOOGLE_ENABLED=false
# Set true in production only after domain verification and reviewed privacy /
# terms pages are deployed.
AUTH_PRODUCTION_READY=false

# Vercel Cron authorization. Generate a separate production-only secret.
CRON_SECRET=replace-with-a-separate-random-secret

# Google OAuth (callback: /api/auth/callback/google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile is mandatory whenever Email OTP is enabled.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Transactional email provider order and shared verified sender.
AUTH_EMAIL_PROVIDERS=resend,mailjet
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=PP Thai League Fantasy

RESEND_API_KEY=
RESEND_DAILY_LIMIT=100
RESEND_MONTHLY_LIMIT=3000

MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_DAILY_LIMIT=200
MAILJET_MONTHLY_LIMIT=6000
